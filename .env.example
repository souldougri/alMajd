# Al-Majd Platform environment variables
# Copy this file to `.env` and adjust the values as needed.
# NEVER commit `.env`. The seeded admin password belongs here only.

# Optional: PostgreSQL connection string.
# If set, the server uses PostgreSQL. If omitted, a local PGLite database
# (file-based) is created under `.data/almajd` inside the project.
# DATABASE_URL=postgresql://user:password@localhost:5432/almajd

# Initial password for the seeded super administrator
# (admin@madjd.org). If omitted, a development fallback is used.
# ALMAJD_ADMIN_PASSWORD=change-me-strong-password

# Session lifetime in days (defaults to 30).
# ALMAJD_SESSION_DAYS=30

# -----------------------------------------------------------------------------
# Deployment mode — allows hosting the public website and the school platform
# separately. These values are baked into the client bundle at build time, so
# only put PUBLIC URLs here (never passwords/tokens).
# -----------------------------------------------------------------------------

# VITE_APP_MODE=site        -> public marketing website (/, /about, /programs, ...).
# VITE_APP_MODE=portal      -> authenticated school platform (welcome -> /login -> desk).
# Unset defaults to "site", so existing marketing URLs keep working unchanged.
# VITE_APP_MODE=site

# Public origin of the portal app. When the site build sets this, the header
# «تسجيل الدخول» button points here instead of the local /login (which is why
# the site deploy must NOT ship the school DB).
# VITE_PORTAL_URL=https://app.example.com

# Public origin of the marketing site (used by the portal build for back links).
# VITE_SITE_URL=https://www.example.com